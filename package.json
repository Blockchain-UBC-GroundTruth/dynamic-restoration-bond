{
  "name": "groundtruth-restoration-bond",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern target",
    "typecheck": "tsc --noEmit",
    "test:program": "cargo test --workspace",
    "anchor:build": "cargo build-sbf --arch v3 --tools-version v1.54 --manifest-path programs/restoration_bond/Cargo.toml",
    "anchor:idl": "anchor idl build -o target/idl/restoration_bond.json -t target/types/restoration_bond.ts",
    "anchor:test": "anchor test",
    "demo:keys": "tsx scripts/demo-create-keys.ts",
    "demo:validator": "solana-test-validator --reset --ledger .demo-wallets/test-ledger",
    "demo:fund:local": "tsx scripts/demo-fund-local.ts",
    "demo:deploy:local": "anchor program deploy target/deploy/restoration_bond.so --program-keypair target/deploy/restoration_bond-keypair.json --provider.cluster localnet --provider.wallet .demo-wallets/deployer.json",
    "demo:deploy:devnet": "anchor program deploy target/deploy/restoration_bond.so --program-keypair target/deploy/restoration_bond-keypair.json --provider.cluster devnet --provider.wallet .demo-wallets/deployer.json",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:advance": "tsx scripts/demo-advance.ts",
    "demo:status": "tsx scripts/demo-status.ts",
    "demo:regulator-key": "tsx scripts/demo-regulator-key.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
